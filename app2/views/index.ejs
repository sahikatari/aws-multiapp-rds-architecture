<!DOCTYPE html>
<html>
<head>
    <title>Node.js Employee Portal</title>

    <style>

        body{
            font-family: Arial;
            background: linear-gradient(to right,#141e30,#243b55);
            color:white;
            display:flex;
            justify-content:center;
            align-items:center;
            height:100vh;
        }

        .box{
            background:white;
            color:black;
            padding:40px;
            border-radius:12px;
            width:350px;
        }

        input{
            width:100%;
            padding:10px;
            margin:10px 0;
        }

        button{
            width:100%;
            padding:12px;
            background:#007bff;
            color:white;
            border:none;
            border-radius:5px;
        }

    </style>

</head>

<body>

<div class="box">

<h2>🚀 Node.js Employee Portal</h2>

<form action="/add" method="POST">

<input type="text" name="name" placeholder="Employee Name" required>

<input type="email" name="email" placeholder="Email" required>

<input type="text" name="department" placeholder="Department" required>

<button type="submit">Add Employee</button>

</form>

</div>

</body>
</html>
